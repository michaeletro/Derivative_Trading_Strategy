# Documentation template only; applications do not load this file automatically.
DTS_BROKER=none
# Required (24+ characters) in tws mode. Generate locally; never commit a real token.
DTS_API_TOKEN=
HTTP_PORT=8080
DB_PATH=quant_data.db
DB_FAIL_FAST=false
ENABLE_IB_WS=false
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=17
IB_MARKET_DATA_TYPE=3
IB_TIMEOUT_MS=10000
POLYGON_API_KEY=

# Defaults to $XDG_DATA_HOME/derivative-lab or $HOME/.local/share/derivative-lab.
# Export absolute local Linux paths. An empty value uses the default.
DTS_DATA_DIR=
DTS_BACKUP_DIR=
DTS_BACKUP_TIMEOUT_SECONDS=30
