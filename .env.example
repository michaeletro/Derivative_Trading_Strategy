# Template only. The application does not load .env files automatically.
# Never put a real credential in this tracked file.
POLYGON_API_KEY=

# Legacy Client Portal transport: disabled unless explicitly enabled.
ENABLE_IB_WS=false
DB_PATH=quant_data.db
DB_CREATE_IF_MISSING=true
DB_RESTORE_FROM_CSV=false
DB_FAIL_FAST=true

# The TWS probe uses CLI flags, not the Client Portal URL or these DB variables.
# python tools/ibkr_connection_probe.py --host 127.0.0.1 --port 7497 --client-id 71
